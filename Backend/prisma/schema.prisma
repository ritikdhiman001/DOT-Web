generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String  @id @default(uuid())
  dotNumber   String  @unique
  email       String  @unique
  password    String
  firstName   String
  lastName    String?
  phone       String
  companyName String?

  role     Role    @default(USER)
  isActive Boolean @default(true)

  createAt DateTime @default(now())
  updateAt DateTime @updatedAt
}

enum Role {
  USER
  ADMIN
}

model Contact {
  id       Int      @id @default(autoincrement())
  fullName String
  email    String
  company  String?
  phone    String?
  subject  String
  message  String
  createAt DateTime @default(now())
}

model Course {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  price       Int
  type        String // Free | Paid
  image       String
  createdAt   DateTime @default(now())
}

model Blog {
  id          String   @id @default(uuid())
  tag         String
  duration    String
  title       String
  description String
  author      String
  createAt    DateTime @default(now())
}
