generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String  @id @default(uuid())
  dotNumber   String  @unique
  email       String  @unique
  password    String
  firstName   String
  lastName    String?
  phone       String
  companyName String?

  role     Role    @default(USER)
  isActive Boolean @default(true)

  orders Order[]

  createAt DateTime @default(now())
  updateAt DateTime @updatedAt
}

enum Role {
  USER
  ADMIN
}

model Contact {
  id       Int      @id @default(autoincrement())
  fullName String
  email    String
  company  String?
  phone    String?
  subject  String
  message  String
  createAt DateTime @default(now())
}

model Course {
  id          Int        @id @default(autoincrement())
  title       String
  description String
  price       Int
  type        CourseType
  image       String
  createdAt   DateTime   @default(now())

  orders Order[]
}

enum CourseType {
  FREE
  PAID
}

model Blog {
  id          String   @id @default(uuid())
  tag         String
  duration    String
  title       String
  description String
  author      String
  createAt    DateTime @default(now())
}

model Order {
  id String @id @default(uuid())

  userId   String
  courseId Int

  user   User   @relation(fields: [userId], references: [id])
  course Course @relation(fields: [courseId], references: [id])

  amount Int
  status OrderStatus @default(PAID)

  createdAt DateTime @default(now())

  @@unique([userId, courseId])
}

enum OrderStatus {
  PAID
  PENDING
  FAILED
}
